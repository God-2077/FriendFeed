---

<div class="social-links">
  {links.map((link) => (
    <a
      href={link.url}
      target="_blank"
      rel="noopener noreferrer"
      class={`social-btn ${link.type}`}
      title={link.label}
      aria-label={link.label}
    >
      {/* eslint-disable-next-line astro/no-set-html-directive */}
      <Fragment set:html={getIconSvg(link.type)} />
    </a>
  ))}
</div>
