---
import { profileConfig, socialConfig } from '@config/config';
import SocialLinks from './SocialLinks.astro';
---

<header class="profile-header">
  <div class="profile-card">
    <div class="avatar-wrapper">
      <div class="avatar-container">
        <img src={profileConfig.avatar} alt={profileConfig.title} class="avatar" />
        <div class="cat-ear left"></div>
        <div class="cat-ear right"></div>
      </div>
    </div>
    
    <div class="profile-info">
      <h1 class="site-title">{profileConfig.title}</h1>
      <p class="site-subtitle">{profileConfig.subtitle}</p>
      <p class="site-bio">{profileConfig.bio}</p>
      <SocialLinks links={socialConfig.links} />
    </div>
    
    <div class="feed-actions">
      <div class="feed-badge">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M3 3c9.941 0 18 8.059 18 18h-3c0-8.284-6.716-15-15-15V3zm0 7c6.075 0 11 4.925 11 11h-3a8 8 0 00-8-8v-3zm0 7a4 4 0 014 4H3v-4z"/></svg>
        RSS Feed Preview
      </div>
      <a 
        class="visit-btn" 
        target="_blank" 
        rel="noopener noreferrer" 
        href={profileConfig.url}
      >
        访问网站 
        <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M16.172 11l-5.364-5.364 1.414-1.414L20 12l-7.778 7.778-1.414-1.414L16.172 13H4v-2z"/></svg>
      </a>
    </div>
  </div>
</header>
