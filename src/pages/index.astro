---
import Layout from '../layouts/Layout.astro';
import Background from '../components/Background.astro';
import ProfileHeader from '../components/ProfileHeader.astro';
import FeedIsland from '../components/react/FeedIsland';
import Footer from '../components/Footer.astro';
import { siteConfig } from '@config/config';

---

<Layout title={siteConfig.title} description={siteConfig.description} openGraphImage={siteConfig.openGraphImage} baseUrl={siteConfig.baseUrl}>
  <Background />
  <div class="container">
    <ProfileHeader />
    <FeedIsland client:load />
    <Footer />
  </div>
</Layout>
